# =============================================================================
# OS / editor cruft
# =============================================================================
.DS_Store
Thumbs.db
*.swp
*.swo
.idea/
.vscode/

# =============================================================================
# Binaries / build output
# =============================================================================
bin/
*.exe
*.dll
*.so
*.dylib
# Local Go binaries that have leaked into the repo root in past branches
/kyoci-agent
/grpc-server
/grpc_client
*.test

# =============================================================================
# Runtime data (SQLite DBs, logs, task workspaces). Authored prompt-skills
# under data/skills/ ARE tracked (shipped knowledge for the 8B agents);
# everything else in data/ is runtime/local and stays ignored.
# =============================================================================
/data/*
!/data/skills/
logs/
tasks/
*.db
*.db-journal
*.sqlite
*.sqlite3

# =============================================================================
# Node.js (portfolio-site, tooling)
# =============================================================================
node_modules/

# =============================================================================
# Local-only / archive / unrelated worktrees
# =============================================================================
.hermes/
_archive_v4/
portfolio-site/
test-projects/

# =============================================================================
# Benchmark runtime artifacts
# =============================================================================
agent_test_env/
app_test_env/
benchmarks/last_response.json
benchmarks/last_response_level_2.json
benchmarks/last_response_level_3_a.json
benchmarks/last_response_level_3_b.json
benchmarks/last_report.txt
benchmarks/last_report_level_1.txt
benchmarks/last_report_level_2.txt
benchmarks/last_report_level_3.txt
benchmarks/last_run_level_1.log
benchmarks/last_run_level_2.log
benchmarks/last_run_level_3.log
benchmarks/last_response_level_4.json
benchmarks/last_report_level_4.txt

# L3 bench transient state
/tmp/kyoci-l3-bench.db

# =============================================================================
# Local dev / scratch (now lives under logs/<YYYY-MM-DD>/ via scripts/dev.sh)
# =============================================================================
# Legacy root-level redirects retained in case anyone runs the servers without
# the dev script. New runs should go through scripts/dev.sh which writes to
# logs/<YYYY-MM-DD>/ automatically.
/backend.log
/frontend.log
/l3_benchmark_output.log
/l3_benchmark_pass_scenarios.txt

# Backups of config we don't want tracked
*.backup

# Playwright MCP scratch dir
.playwright-mcp/

# L3 bench transient state
/tmp/kyoci-l3-bench.db

# Build artifacts (do not commit)
/server
/web/dist/
*.tsbuildinfo
